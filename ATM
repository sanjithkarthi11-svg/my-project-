
#include <stdio.h>

int main()
{
    int pin = 1234;
    int enteredPin;
    int balance = 5000;
    int choice, amount;

    printf("Enter your PIN: ");
    scanf("%d", &enteredPin);

    if(enteredPin == pin)
    {
        printf("\n1. Check Balance");
        printf("\n2. Deposit");
        printf("\n3. Withdraw");
        printf("\n4. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Balance = Rs.%d", balance);
                break;

            case 2:
                printf("Enter deposit amount: ");
                scanf("%d", &amount);
                if(amount > 0)
                {
                    balance = balance + amount;
                    printf("New Balance = Rs.%d", balance);
                }
                else
                    printf("Invalid amount");
                break;

            case 3:
                printf("Enter withdrawal amount: ");
                scanf("%d", &amount);

                if(amount > 0 && amount <= balance)
                {
                    balance = balance - amount;
                    printf("New Balance = Rs.%d", balance);
                }
                else
                    printf("Insufficient balance or invalid amount");
                break;

            case 4:
                printf("Thank you!");
                break;

            default:
                printf("Invalid choice");
        }
    }
    else
    {
        printf("Incorrect PIN");
    }

    return 0;
}
