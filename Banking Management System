
#include <stdio.h>

int main()
{
    int choice, accountNo = 101;
    float balance = 5000, amount;

    printf("===== BANKING MANAGEMENT SYSTEM =====\n");

    do
    {
        printf("\n1. Check Balance");
        printf("\n2. Deposit Money");
        printf("\n3. Withdraw Money");
        printf("\n4. Account Details");
        printf("\n5. Exit");

        printf("\n\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("\nYour Balance = Rs. %.2f", balance);
                break;

            case 2:
                printf("\nEnter deposit amount: ");
                scanf("%f", &amount);

                if(amount > 0)
                {
                    balance = balance + amount;
                    printf("Money Deposited Successfully!");
                    printf("\nNew Balance = Rs. %.2f", balance);
                }
                else
                {
                    printf("Invalid Amount!");
                }
                break;

            case 3:
                printf("\nEnter withdrawal amount: ");
                scanf("%f", &amount);

                if(amount > 0 && amount <= balance)
                {
                    balance = balance - amount;
                    printf("Withdrawal Successful!");
                    printf("\nRemaining Balance = Rs. %.2f", balance);
                }
                else
                {
                    printf("Invalid Amount or Insufficient Balance!");
                }
                break;

            case 4:
                printf("\nAccount Number: %d", accountNo);
                printf("\nAccount Balance: Rs. %.2f", balance);
                break;

            case 5:
                printf("\nThank you for using our bank!");
                break;

            default:
                printf("\nInvalid Choice!");
        }

    } while(choice != 5);

    return 0;
}
